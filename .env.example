# Voice output: id-ID-GadisNeural (ANNA) atau id-ID-ArdiNeural (MAX).
ANA_VOICE_ID=id-ID-ArdiNeural

# Hermes profile whose tools, skills, memory, browser, and MCP servers are inherited.
HERMES_PROFILE=anna

# Optional absolute command if `hermes` is not on PATH.
# HERMES_CMD=/absolute/path/to/hermes

# Agent working directory and local dashboard port.
ANA_WORKDIR=~
ANA_PERMISSION=normal
ANA_TIMEOUT=120
ANA_PORT=8730
ANA_OPEN=1

# Bind host: 127.0.0.1 = localhost saja; 0.0.0.0 = bisa diakses via IP LAN.
ANA_HOST=127.0.0.1

# Domain reverse-proxy/tunnel yang diizinkan (koma, tanpa port).
# Wajib diisi saat diakses via domain/tunnel ke localhost (tanpa ini 403).
# Contoh: ANA_ALLOWED_HOSTS=agen.kphbwb.web.id
# ANA_ALLOWED_HOSTS=

# --- Database internal (MariaDB kph_bwb_sandbox2) — dipakai auth lokal + SIMOGE ---
# Hanya DB_* yang dipakai. SIMOGE otomatis fallback ke DB_* bila SIMOGE_DB_* tidak ada.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kph_bwb_sandbox2

# --- Pilihan sumber DB: local | remote ---
# local  = DB_* di atas (seperti saat ini)
# remote = REMOTE_DB_* via ssh tunnel kphbwb-tunnel (127.0.0.1:13307 -> 3306 server)
# Switch tanpa restart via tombol 🗄 di dashboard (POST /api/db-source).
ANA_DB_SOURCE=local
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=13307
REMOTE_DB_USER=root
REMOTE_DB_PASSWORD=
REMOTE_DB_NAME=kph_bwb_sandbox2

OBSIDIAN_VAULT_PATH="$HOME/anna_brain/Anna's brain"
WIKI_PATH="$HOME/anna_brain/Anna's brain/ANNA-KNOWLEDGE"

# Override mutlak lokasi scripts simoge-business (default:
# $HERMES_HOME/profiles/<HERMES_PROFILE>/skills/software-development/simoge-business/scripts).
# ANA_SIMOGE_SCRIPTS=/opt/simoge/scripts

ANA_JOURNAL_PATH="$HOME/ana_journal/ana"

# Auth lokal (internal DB, tanpa Directus)
ANA_AUTH_REQUIRED=1

# Mode server: develop = log per-request nyala; production = log mati.
# Default develop bila tak di-set.
ANA_MODE=develop

# Override sekali jalan: ANA_DEBUG_MAP=1 = log map/token per baris.
# ANA_DEBUG_MAP=1

# Base URL Directus server KPHBWB (foto aktivitas mobile -> storage server).
# Publik, tanpa kredensial. Popup pin ambil /assets/<id> langsung dari sini.
# Sama dengan default kode bila tak di-set.
DIRECTUS_URL=https://sandbox2.kphbwb.web.id

# --- Kredensial layanan Hermes (Opsi 2: serve gated) ---
# Dipakai server untuk login ke Hermes + mint tiket WS per-connect.
# Basis auth OTOMATIS mengikuti ANA_GATEWAY_URL (tiket in-memory per proses,
# wajib satu proses dengan WS); override manual hanya bila perlu:
# HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# HERMES_SERVICE_PROVIDER=basic
# HERMES_SERVICE_USER=
# HERMES_SERVICE_PASSWORD=
# HANYA di .env server (JANGAN commit). Tanpa ini = jalur legacy (dev).
ANA_SESSION_TTL=28800
ANA_DEVICE_SALT=change-me-random-hex
ANA_COOKIE_SECURE=0
