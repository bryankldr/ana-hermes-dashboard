# ============================================================
# ANNA HUD — contoh konfigurasi (.env)
# Pakai: cp .env.example .env  lalu isi nilai bertanda <...>
# Urutan blok di bawah = urutan .env server, supaya mudah dibandingkan.
# ============================================================

# --- 1. Agen & proses ---------------------------------------
# Profil Hermes yang diwarisi (tools, skills, memory, browser, MCP).
HERMES_PROFILE=anna

# Mode server: develop = log per-request nyala; production = log mati.
# Default develop bila tak di-set.
ANA_MODE=develop

# Debug per-jalur (sekali jalan): ANA_DEBUG_MAP=1 = traceback map/token.
# Biarkan 0 di produksi.
ANA_DEBUG_MAP=0

# Workdir agen + port dashboard.
ANA_WORKDIR=~
ANA_PERMISSION=normal
ANA_TIMEOUT=120
ANA_PORT=8730
ANA_OPEN=1

# (opsional) path absolut binary hermes bila tak ada di PATH.
# HERMES_CMD=/absolute/path/to/hermes

# --- 2. Jaringan & akses publik ------------------------------
# Bind host: 127.0.0.1 = localhost saja; 0.0.0.0 = bisa diakses IP LAN.
ANA_HOST=127.0.0.1

# Domain reverse-proxy/tunnel yang diizinkan (pisah koma, tanpa port).
# WAJIB diisi bila diakses lewat domain — tanpa ini Host/Origin ditolak 403.
# LAN saja: kosongkan. Produksi: hud.kphbwb.web.id
ANA_ALLOWED_HOSTS=

# Catatan deploy Apache/XAMPP + Cloudflare Tunnel ke domain ini:
# - Apache: ProxyPreserveHost On
#            RequestHeader set X-Forwarded-Proto "https"
#            ProxyPass / http://127.0.0.1:8730/ flushpackets=on
# - Cookie otomatis Secure bila proxy kirim X-Forwarded-Proto: https
#   (header hanya dipercaya dari loopback) → ANA_COOKIE_SECURE=0 tetap benar
#   dan akses LAN http://IP:8730 tidak rusak.
# - JANGAN pasang Access-Control-Allow-Origin di Apache: UI + API satu origin.

# --- 3. Database internal (MariaDB kph_bwb_sandbox2) ----------
# Dipakai auth lokal + SIMOGE. SIMOGE otomatis fallback ke DB_* bila
# SIMOGE_DB_* tidak ada.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kph_bwb_sandbox2
DB_USER=root
DB_PASSWORD=

# Sumber DB: local = DB_* di atas; remote = REMOTE_DB_* lewat ssh tunnel
# kphbwb-tunnel (127.0.0.1:13307 -> 3306 server). Switch tanpa restart via
# tombol DB di dashboard (POST /api/db-source).
ANA_DB_SOURCE=local
# (opsional) hanya dipakai saat ANA_DB_SOURCE=remote
# REMOTE_DB_HOST=127.0.0.1
# REMOTE_DB_PORT=13307
# REMOTE_DB_USER=root
# REMOTE_DB_PASSWORD=
# REMOTE_DB_NAME=kph_bwb_sandbox2

# --- 4. Vault & path skrip ------------------------------------
# Second brain ANNA (Obsidian) + journal Ana.
OBSIDIAN_VAULT_PATH="$HOME/anna_brain/Anna's brain"
WIKI_PATH="$HOME/anna_brain/Anna's brain/ANNA-KNOWLEDGE"
ANA_JOURNAL_PATH="$HOME/ana_journal/ana"

# Override mutlak lokasi script simoge-business. Kosongkan untuk default:
# $HERMES_HOME/profiles/<HERMES_PROFILE>/skills/software-development/simoge-business/scripts
ANA_SIMOGE_SCRIPTS=

# --- 5. Auth & sesi -------------------------------------------
# 1 = semua /api/* butuh token/sesi (wajib di produksi). 0 = terbuka (dev).
ANA_AUTH_REQUIRED=1

# 2FA (TOTP): 1 = wajib sesuai flag per-user; 0 = mati (password saja).
# Dibaca tiap request (tanpa restart). JANGAN 0 di produksi.
# Legacy ANA_TFA_BYPASS=1 identik dengan 0.
ANA_2FA_ENABLED=1

# Umur sesi login (detik) — 28800 = 8 jam.
ANA_SESSION_TTL=28800

# Salt hash device (hex acak). Ganti per instalasi; JANGAN commit nilai asli.
ANA_DEVICE_SALT=change-me-random-hex

# 0 = ikut deteksi proxy (X-Forwarded-Proto https → cookie Secure).
# 1 = paksa Secure (akses via http biasa jadi tak bisa login).
ANA_COOKIE_SECURE=0

# --- 6. Integrasi layanan -------------------------------------
# Directus KPHBWB (foto aktivitas mobile -> storage server). Publik.
DIRECTUS_URL=https://sandbox2.kphbwb.web.id

# Metabase MAXBI (proxy /api/metabase/* + /maxbi). Tanpa MB_API_KEY →
# endpoint menjawab configured:false.
MB_BASE_URL=https://bi.kphbwb.web.id
MB_API_KEY=

# (opsional) kredensial layanan Hermes untuk mint tiket WS per-connect.
# HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# HERMES_SERVICE_PROVIDER=basic
# HERMES_SERVICE_USER=
# HERMES_SERVICE_PASSWORD=

# (opsional) suara TTS: id-ID-GadisNeural (ANNA) / id-ID-ArdiNeural (MAX).
# ANA_VOICE_ID=id-ID-GadisNeural
