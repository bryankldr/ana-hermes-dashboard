[Unit]
Description=Hermes web dashboard
After=network-online.target hermes-serve.service
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/hermes dashboard --isolated --port 9121 --host 127.0.0.1 --skip-build --no-open
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
